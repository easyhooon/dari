{
  "name": "@easyhooon/dari-web",
  "version": "0.1.0",
  "description": "Floating in-page panel for inspecting WebView bridge messages from the web side",
  "license": "Apache-2.0",
  "author": "Lee jihun",
  "homepage": "https://github.com/easyhooon/dari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easyhooon/dari.git",
    "directory": "dari-web"
  },
  "keywords": [
    "webview",
    "bridge",
    "inspector",
    "debug",
    "javascript-bridge"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
