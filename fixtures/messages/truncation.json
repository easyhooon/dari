  "expected": [
    {
      "summary": {
        "id": 1, "requestId": "u1", "handlerName": "upload", "direction": "WEB_TO_APP", "tag": "main",
        "status": "SUCCESS", "requestTimestamp": 3000, "responseTimestamp": 3005,
        "requestSizeBytes": 48, "responseSizeBytes": 2
      },
      "requestData": "abcde\n\n...[truncated, original length: 10 chars]",
